CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
D1_DATABASE_ID=your-d1-database-id
CLOUDFLARE_API_TOKEN=your-d1-edit-api-token

# Leave empty for a direct connection. Xray/V2Ray can expose VMess as HTTP here.
BILI_PROXY_URL=http://127.0.0.1:10809

# Optional local override. In production, leave this empty and use app_config in D1.
# BILIBILI_COOKIE_FILE=/etc/pace-radar/cookie.txt
